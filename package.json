{
  "name": "yawswith",
  "displayName": "Yawswith",
  "description": "Switch pinned projects from the sidebar, status bar, or keyboard.",
  "version": "4.0.5",
  "publisher": "www159-used",
  "icon": "icon.png",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/www159-used/yawswith.git"
  },
  "bugs": {
    "url": "https://github.com/www159-used/yawswith/issues"
  },
  "homepage": "https://github.com/www159-used/yawswith#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "project",
    "workspace",
    "switch",
    "yawswith"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:yawswith.sidebarView",
    "onView:yawswith.projectsTree",
    "onCommand:yawswith.switchProject",
    "onCommand:yawswith.focus",
    "onCommand:yawswith.openProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yawswithContainer",
          "title": "Yawswith",
          "icon": "activity_icon.svg"
        }
      ]
    },
    "views": {
      "yawswithContainer": [
        {
          "type": "webview",
          "id": "yawswith.sidebarView",
          "name": "Projects"
        },
        {
          "type": "tree",
          "id": "yawswith.projectsTree",
          "name": "Pinned Projects"
        }
      ]
    },
    "commands": [
      {
        "command": "yawswith.addProject",
        "title": "Yawswith: Pin Current Project"
      },
      {
        "command": "yawswith.switchProject",
        "title": "Yawswith: Switch Project"
      },
      {
        "command": "yawswith.focus",
        "title": "Yawswith: Show Dashboard"
      },
      {
        "command": "yawswith.openProject",
        "title": "Yawswith: Open Project"
      },
      {
        "command": "yawswith.openProject1",
        "title": "Yawswith: Open Project 1"
      },
      {
        "command": "yawswith.openProject2",
        "title": "Yawswith: Open Project 2"
      },
      {
        "command": "yawswith.openProject3",
        "title": "Yawswith: Open Project 3"
      },
      {
        "command": "yawswith.openProject4",
        "title": "Yawswith: Open Project 4"
      },
      {
        "command": "yawswith.openProject5",
        "title": "Yawswith: Open Project 5"
      },
      {
        "command": "yawswith.openProject6",
        "title": "Yawswith: Open Project 6"
      },
      {
        "command": "yawswith.openProject7",
        "title": "Yawswith: Open Project 7"
      },
      {
        "command": "yawswith.openProject8",
        "title": "Yawswith: Open Project 8"
      },
      {
        "command": "yawswith.openProject9",
        "title": "Yawswith: Open Project 9"
      }
    ],
    "keybindings": [
      {
        "command": "yawswith.openProject1",
        "key": "cmd+1",
        "mac": "cmd+1"
      },
      {
        "command": "yawswith.openProject2",
        "key": "cmd+2",
        "mac": "cmd+2"
      },
      {
        "command": "yawswith.openProject3",
        "key": "cmd+3",
        "mac": "cmd+3"
      },
      {
        "command": "yawswith.openProject4",
        "key": "cmd+4",
        "mac": "cmd+4"
      },
      {
        "command": "yawswith.openProject5",
        "key": "cmd+5",
        "mac": "cmd+5"
      },
      {
        "command": "yawswith.openProject6",
        "key": "cmd+6",
        "mac": "cmd+6"
      },
      {
        "command": "yawswith.openProject7",
        "key": "cmd+7",
        "mac": "cmd+7"
      },
      {
        "command": "yawswith.openProject8",
        "key": "cmd+8",
        "mac": "cmd+8"
      },
      {
        "command": "yawswith.openProject9",
        "key": "cmd+9",
        "mac": "cmd+9"
      },
      {
        "command": "yawswith.switchProject",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "yawswith.switchProject",
          "when": "view == yawswith.sidebarView",
          "group": "navigation"
        },
        {
          "command": "yawswith.addProject",
          "when": "view == yawswith.sidebarView",
          "group": "navigation"
        },
        {
          "command": "yawswith.addProject",
          "when": "view == yawswith.projectsTree",
          "group": "navigation"
        },
        {
          "command": "yawswith.switchProject",
          "when": "view == yawswith.projectsTree",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Yawswith",
      "properties": {
        "projectTabs.projects": {
          "type": "array",
          "default": [],
          "scope": "application",
          "description": "Pinned projects. Application-scoped so every VS Code / Cursor profile shares the same list.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "group": {
                "type": "string",
                "description": "Optional group/tag for the project"
              },
              "icon": {
                "type": "string",
                "description": "Optional codicon identifier (e.g. 'star', 'code')"
              },
              "color": {
                "type": "string",
                "description": "Optional ThemeColor ID or hex value"
              }
            }
          }
        },
        "projectTabs.statusBarMaxItems": {
          "type": "number",
          "default": 6,
          "minimum": 0,
          "maximum": 20,
          "description": "How many pinned projects to show as one-click buttons in the status bar. Set to 0 to disable."
        }
      }
    }
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/vscode": "1.75.0",
    "@vscode/vsce": "4.0.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14"
  },
  "scripts": {
    "compile": "npm run clean && tsc -p . && tsc -p tsconfig.webview.json && vite build",
    "check": "tsc -p . --noEmit && tsc -p tsconfig.webview.json",
    "watch": "tsc -p . --watch",
    "test": "npm run compile && node --test out/*.test.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "watch:webview": "vite build --watch"
  },
  "dependencies": {
    "solid-js": "1.9.17"
  }
}
