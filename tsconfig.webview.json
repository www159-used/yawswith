{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "types": ["vite/client"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["src/webview/**/*.tsx", "src/webview/hooks/**/*.ts", "src/webview/messages.ts", "src/model.ts"],
  "exclude": []
}
